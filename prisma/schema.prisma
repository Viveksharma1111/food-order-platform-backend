generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  CUSTOMER
}

enum OrderStatus {
  PLACED
  PREPARING
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(CUSTOMER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders       Order[]

  @@index([role, active])
  @@map("users")
}

model Food {
  id          String      @id @default(cuid())
  name        String      @db.VarChar(160)
  description String      @db.Text
  category    String      @db.VarChar(80)
  price       Decimal     @db.Decimal(10, 2)
  available   Boolean     @default(true)
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  orderItems  OrderItem[]

  @@index([available, archived])
  @@index([category])
  @@map("foods")
}

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique @db.VarChar(32)
  customerId String      @map("customer_id")
  status     OrderStatus @default(PLACED)
  notes      String?     @db.VarChar(1000)
  total      Decimal     @db.Decimal(12, 2)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer   User        @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items      OrderItem[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String  @map("order_id")
  foodId            String  @map("food_id")
  foodNameSnapshot  String  @map("food_name_snapshot") @db.VarChar(160)
  unitPriceSnapshot Decimal @map("unit_price_snapshot") @db.Decimal(10, 2)
  quantity          Int
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  food              Food    @relation(fields: [foodId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([foodId])
  @@map("order_items")
}
